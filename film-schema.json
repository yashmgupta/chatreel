{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatreel.example/film-schema.json",
  "title": "Chatreel Film",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "style",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "style": {
      "enum": [
        "swiss-motion",
        "blueprint",
        "chalkboard",
        "woodcut",
        "pixel-rpg"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 1280,
      "multipleOf": 2,
      "default": 640
    },
    "height": {
      "type": "integer",
      "minimum": 180,
      "maximum": 720,
      "multipleOf": 2,
      "default": 360
    },
    "fps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 30,
      "default": 24
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "default": 7
    },
    "voice": {
      "enum": [
        "subtitles",
        "tts"
      ],
      "default": "subtitles"
    },
    "webgl": {
      "type": "boolean",
      "default": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration",
          "title",
          "objects"
        ],
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "narration": {
            "type": "string",
            "maxLength": 240,
            "default": ""
          },
          "camera": {
            "enum": [
              "locked",
              "push",
              "pan"
            ],
            "default": "locked"
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shape",
                "x",
                "y"
              ],
              "properties": {
                "shape": {
                  "enum": [
                    "circle",
                    "box",
                    "triangle",
                    "person"
                  ]
                },
                "x": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 0.9
                },
                "y": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 0.65
                },
                "size": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 0.18,
                  "default": 0.1
                },
                "motion": {
                  "enum": [
                    "still",
                    "drift",
                    "pulse"
                  ],
                  "default": "still"
                },
                "accent": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 180,
          "default": 100
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.15
        },
        "cues": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "note"
            ],
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 120
              },
              "note": {
                "type": "integer",
                "minimum": 36,
                "maximum": 96
              },
              "duration": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 4,
                "default": 0.4
              }
            }
          }
        }
      }
    }
  }
}
